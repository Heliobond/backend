{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heliobond.io/schemas/creator-application.schema.json",
  "title": "Creator Application Metadata",
  "description": "Project metadata submitted by a creator via POST /v1/creators/applications. Validated server-side before any whitelisting or on-chain work.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "location", "capacity_kw", "documents"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Human-readable project name."
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Free-form location label, e.g. \"Lagos, Nigeria\"."
    },
    "capacity_kw": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000,
      "description": "Installed capacity in kilowatts."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^(ipfs://[^\\s]+|https://[^\\s]+|ar://[^\\s]+)$",
        "description": "Supporting document URI. Only the ipfs, https and ar schemes are accepted."
      }
    }
  }
}
