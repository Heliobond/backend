{
  "name": "heliobond-backend",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/index.ts",
    "dev:no-watch": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/exporter-zipkin": "2.11.0",
    "@opentelemetry/instrumentation-express": "0.69.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@stellar/stellar-sdk": "17.1.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dataloader": "2.2.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "graphql": "17.0.2",
    "graphql-http": "1.23.0",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "node-cron": "4.6.0",
    "pg": "8.23.0",
    "prom-client": "15.1.3",
    "swagger-ui-express": "5.0.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@types/ws": "8.18.1",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "yaml": "2.9.1"
  }
}
